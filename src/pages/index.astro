---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const selectedCategoryValues = Astro.url.searchParams.getAll('category');
const selectedPublisherValue = Astro.url.searchParams.get('publisher');
const selectedCategoryIds = selectedCategoryValues
    .map((value) => Number(value))
    .filter((value) => Number.isInteger(value) && value > 0);
const selectedPublisherId = Number(selectedPublisherValue ?? '');
const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
const games = await getAllGames(getDatabase(), {
    categoryIds: selectedCategoryIds.length > 0 ? selectedCategoryIds : undefined,
    publisherIds: Number.isInteger(selectedPublisherId) && selectedPublisherId > 0 ? [selectedPublisherId] : undefined,
});
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <form method="get" action="/" class="mb-8 rounded-xl border border-slate-700 bg-slate-800/70 p-5 shadow-lg" data-testid="game-filters">
      <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
        <div class="flex-1">
          <label for="publisher-filter" class="mb-2 block text-sm font-medium text-slate-200">Publisher</label>
          <select
            id="publisher-filter"
            name="publisher"
            class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
            data-testid="publisher-filter"
            aria-label="Filter games by publisher"
          >
            <option value="">All publishers</option>
            {publishers.map((publisher) => (
              <option value={publisher.id} selected={selectedPublisherId === publisher.id}>{publisher.name}</option>
            ))}
          </select>
        </div>

        <div class="flex-1">
          <fieldset class="border-0 p-0 m-0">
            <legend class="mb-2 block text-sm font-medium text-slate-200">Categories</legend>
            <div class="flex flex-wrap gap-2">
              {categories.map((category) => (
                <label
                  class="inline-flex items-center gap-2 rounded-full border border-slate-600 bg-slate-900 px-3 py-2 text-sm text-slate-200 transition-colors hover:border-blue-500 focus-within:ring-2 focus-within:ring-blue-500"
                  data-testid={`category-filter-${category.id}`}
                >
                  <input
                    type="checkbox"
                    name="category"
                    value={category.id}
                    checked={selectedCategoryIds.includes(category.id)}
                    class="h-4 w-4 rounded border-slate-500 bg-slate-800 text-blue-500 focus:ring-blue-500"
                    aria-label={`Filter by category ${category.name}`}
                  />
                  <span>{category.name}</span>
                </label>
              ))}
            </div>
          </fieldset>
        </div>
      </div>

      <div class="mt-5 flex flex-wrap items-center gap-3">
        <button
          type="submit"
          class="rounded-lg bg-blue-600 px-4 py-2 font-medium text-white transition-colors hover:bg-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
          data-testid="apply-filters-button"
        >
          Apply filters
        </button>
        <a
          href="/"
          class="rounded-lg border border-slate-600 px-4 py-2 font-medium text-slate-200 transition-colors hover:border-slate-400 hover:text-white focus:outline-none focus:ring-2 focus:ring-blue-500"
          data-testid="clear-filters-button"
        >
          Clear filters
        </a>
      </div>
    </form>

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text={selectedCategoryIds.length > 0 || selectedPublisherId > 0 ? 'No games match the current filters.' : 'No games available at the moment.'} />
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}
    </div>
  </div>
</Layout>
